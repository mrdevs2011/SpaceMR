{
  "name": "SpaceMR",
  "short_name": "SpaceMR",
  "description": "SpaceMR — yopiq ijtimoiy tarmoq. Lenta, chat, guruhlar va qo'ng'iroq.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "orientation": "portrait-primary",
  "lang": "uz",
  "categories": [
    "social",
    "communication"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "/",
  "shortcuts": [
    {
      "name": "Suhbatlar",
      "short_name": "Suhbatlar",
      "description": "Xabarlar va guruhlar",
      "url": "/chats",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Bildirishnomalar",
      "short_name": "Xabarnoma",
      "description": "Yangi bildirishnomalar",
      "url": "/notifications",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Saqlanganlar",
      "short_name": "Saqlangan",
      "description": "Saqlangan postlar",
      "url": "/saved",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://spacemr.vercel.app/manifest.json"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "video/*", "application/pdf", ".jpg", ".jpeg", ".png", ".gif", ".webp", ".mp4", ".mov"]
        }
      ]
    }
  }
}
